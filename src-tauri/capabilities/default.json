{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local studio window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-set-theme",
    "core:window:allow-set-title"
  ]
}
